{
  "name": "progen",
  "version": "2.0.0",
  "description": "Lightweight 3D Modeling Desktop Application",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "3d",
    "modeling",
    "desktop-app",
    "electron",
    "lightweight"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.progen.app",
    "productName": "Pro-Gen",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
